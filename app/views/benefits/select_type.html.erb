<%= turbo_frame_tag 'benefit_form' do %>
  <div class="box mt-3 p-4 workspace-form" id="select_benefit_type_box">
    <h2 class="title is-6 mb-1">Choose Benefit Type</h2>
    <p class="subtitle is-7 mb-3"><%= @user.name %></p>

    <div class="buttons">
      <% Benefit::TYPES.each do |type| %>
        <%= link_to type.constantize.new.type_name,
            new_user_benefit_path(@user, type: type),
            class: "button is-small is-primary is-outlined",
            id: "benefit_type_#{type.demodulize.underscore}" %>
      <% end %>
    </div>

    <%= link_to "Cancel", root_path, class: "button is-small is-light" %>
  </div>
<% end %>
